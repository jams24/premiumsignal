# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cryptosignal

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=your_channel_id
# Comma-separated Telegram user IDs with admin access (required — first admin bootstraps the bot)
ADMIN_TELEGRAM_IDS=123456789

# Exchange API Keys (read-only keys recommended)
BINANCE_API_KEY=
BINANCE_SECRET=
MEXC_API_KEY=
MEXC_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=

# On-Chain APIs
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
SOLSCAN_API_KEY=
ALCHEMY_API_KEY=
MORALIS_API_KEY=

# Optional: Twitter/X API for social sentiment
TWITTER_BEARER_TOKEN=

# Signal Settings
MIN_VOLUME_SPIKE_MULTIPLIER=3
MIN_PRICE_CHANGE_PERCENT=5
SCAN_INTERVAL_SECONDS=30
LISTING_CHECK_INTERVAL_SECONDS=60
